# Copy to .env and fill in before `docker compose up`.

# --- Auth ---
LABX_ADMIN_USERNAME=admin
LABX_ADMIN_PASSWORD=change-me
# openssl rand -hex 32
LABX_JWT_SECRET=change-me-too

# --- Secrets-at-rest (Azure profiles, MCP-server auth) ---
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LABX_FERNET_KEY=

# --- Internal loopback auth (backend <-> its own MCP-gateway subprocess) ---
# Fixed on purpose, not generated per-process: the gateway subprocess (spawned
# fresh by the Claude Code CLI each turn) must present the SAME token the
# main server validates. python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LABX_INTERNAL_TOKEN=

# --- Claude Code CLI ---
# `claude setup-token` on a machine where you're logged in (subscription auth,
# not an API key) — or leave empty and set it later via Settings in the app.
CLAUDE_CODE_OAUTH_TOKEN=
LABX_CLI_PATH=claude
LABX_CLI_DEFAULT_MODEL=claude-sonnet-5

# --- Docker sibling-runtime ---
# unix:///var/run/docker.sock (default) works once docker-compose.yml mounts
# the socket. Point this at a docker-socket-proxy URL instead
# (tcp://socket-proxy:2375) to harden later — no code change needed.
LABX_DOCKER_HOST=unix:///var/run/docker.sock

# --- Data-guard (track B: local model second opinion) ---
DATA_GUARD_LLM_ENABLED=1
DATA_GUARD_LLM_MODEL=qwen2.5:1.5b
# Leave empty to auto-resolve (host.docker.internal:11434 in a container,
# localhost:11434 otherwise). Point at the `ollama` compose service
# (http://ollama:11434) if you enabled the `with-ollama` profile.
DATA_GUARD_LLM_URL=

# --- Misc ---
LABX_CORS_ORIGINS=*
LABX_API_URL=http://localhost:8090
